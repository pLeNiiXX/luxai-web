---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Title from '../components/Title.astro';
import { DEMOS, type Demo } from '../data/demos';
import { routes, collectionBase, otherLang, type Lang } from '../i18n/routes';
import { videoNode, faqNode } from '../lib/seo';

interface Props { lang: Lang; demo: Demo }
const { lang, demo } = Astro.props;
const r = (k: keyof typeof routes) => routes[k][lang];
const path = `${collectionBase.demos[lang]}${demo.slug[lang]}/`;
const altPath = `${collectionBase.demos[otherLang(lang)]}${demo.slug[otherLang(lang)]}/`;
const other = DEMOS.find((d) => d.key !== demo.key)!;
const otherPath = `${collectionBase.demos[lang]}${other.slug[lang]}/`;
const isVilla = demo.key === 'villa-costa';

const seo = {
  'villa-costa': {
    es: {
      title: 'Villa contemporánea: de 4 fotos a vídeo con IA | LUXAI',
      description: 'Cuatro fotos de una villa frente al mar convertidas en una secuencia de estilo aéreo: piscina infinita, pista de tenis y atardecer. Vídeo en 16:9.',
      h1: 'Villa Contemporánea Costa: | de 4 fotos a un vídeo de estilo aéreo',
    },
    en: {
      title: 'Coastal Villa: 4 Photos Turned into an AI Film | LUXAI',
      description: 'Four photos of a sea-view villa turned into an aerial-style sequence: infinity pool, tennis court and sunset over the water. 16:9 film.',
      h1: 'Coastal Contemporary Villa: | from 4 photos to an aerial-style film',
    },
  },
  'finca-rustica': {
    es: {
      title: 'Finca rústica: de 5 fotos a 24 s de vídeo con IA | LUXAI',
      description: 'Cinco fotos de una finca de piedra convertidas en 24 segundos de vídeo: jardines de lavanda, piscina de piedra y paso al interior con chimenea.',
      h1: 'Finca Rústica Mediterránea: | de 5 fotos a 24 segundos de vídeo',
    },
    en: {
      title: 'Rustic Estate: 5 Photos, 24 Seconds of AI Film | LUXAI',
      description: 'Five photos of a stone finca turned into 24 seconds of film: lavender gardens, natural stone pool and a move indoors to the fireplace and timber beams.',
      h1: 'Mediterranean Rustic Estate: | 5 photos, 24 seconds of film',
    },
  },
}[demo.key as 'villa-costa' | 'finca-rustica'][lang];

const c = {
  es: {
    crumb: 'Demostraciones',
    label: `Movimiento de cámara con IA dentro de ${demo.photos.length} fotografías`,
    facts: { photos: 'Fotos de partida', duration: 'Duración', format: 'Formato', style: 'Estilo' },
    source: { eyebrow: 'Punto de partida', title: `Las ${demo.photos.length} fotos de partida`, lede: 'Estas son las fotografías de las que parte la demo. Cada plano del vídeo sale de una de ellas: comparadlos.' },
    shots: { eyebrow: 'Plano a plano', title: 'Cómo está construido el vídeo' },
    retouch: {
      eyebrow: 'Qué ha hecho la IA',
      title: 'Lo que hace la IA | y lo que no',
      done: { t: 'Hecho con IA', items: ['El mapa de profundidad de cada foto', 'El movimiento de cámara con paralaje dentro de cada foto', 'Nada más: el orden, el ritmo y los fundidos son montaje nuestro'] },
      kept: { t: 'Sin tocar', items: ['La arquitectura, los materiales y el mobiliario', 'Las vistas y el entorno de cada foto', 'Ninguna estancia ni objeto añadido'] },
    },
    links: isVilla
      ? [
          { href: otherPath, label: 'Siguiente demo: finca rústica de piedra' },
          { href: r('how'), label: 'Qué hace la IA con cada foto' },
          { href: r('pricing'), label: 'Cuánto cuesta un vídeo así' },
        ]
      : [
          { href: otherPath, label: 'Otra demo: villa contemporánea' },
          { href: r('rentals'), label: 'Vídeo para fincas y villas de alquiler vacacional' },
          { href: `${r('contact')}#demo`, label: 'Pedid la demo con vuestra finca' },
        ],
    faq: [
      ...(isVilla ? [{ q: '¿Qué movimientos de cámara se usan en una villa?', a: 'Los que la foto permite sin forzarla: deslizamientos laterales a ras de agua, avances hacia la fachada o el salón y elevaciones que abren el plano. En esta villa, el deslizamiento sobre la piscina infinita y la elevación final son los dos planos que más recuerdan a un dron.' }] : []),
      { q: '¿Todo lo que aparece en el vídeo está en las fotos?', a: 'Sí. Cada plano sale de una sola foto: la IA calcula su profundidad y la cámara se mueve dentro de ella, así que no aparece ninguna estancia, mueble ni vista que no esté en la foto. Entre plano y plano hay un fundido, no una transición inventada. Aun así, el vídeo se publica etiquetado como hecho con IA.' },
    ],
    cta: { eyebrow: 'Vuestra propiedad', title: '¿La próxima demo es vuestra?', text: 'Enviadnos las fotos de una villa o una finca y en 72 horas tenéis una muestra en vídeo, sin coste ni compromiso.' },
    more: 'Más demostraciones',
  },
  en: {
    crumb: 'Demos',
    label: `AI camera movement inside ${demo.photos.length} photographs`,
    facts: { photos: 'Source photos', duration: 'Length', format: 'Format', style: 'Style' },
    source: { eyebrow: 'Starting point', title: `The ${demo.photos.length} source photos`, lede: 'These are the photographs the demo starts from. Every shot in the film comes from one of them: compare them.' },
    shots: { eyebrow: 'Shot by shot', title: 'How the film is built' },
    retouch: {
      eyebrow: 'What the AI did',
      title: 'What the AI does, | and what it doesn’t',
      done: { t: 'Made with AI', items: ['The depth map of each photo', 'The parallax camera movement inside each photo', 'Nothing else: the order, pacing and dissolves are our own editing'] },
      kept: { t: 'Untouched', items: ['The architecture, materials and furniture', 'The views and surroundings in each photo', 'No room or object added'] },
    },
    links: isVilla
      ? [
          { href: otherPath, label: 'Next demo: Mediterranean stone estate' },
          { href: r('how'), label: 'What the AI does with each photo' },
          { href: r('pricing'), label: 'What a film like this costs' },
        ]
      : [
          { href: otherPath, label: 'Another demo: coastal contemporary villa' },
          { href: r('rentals'), label: 'Video for rental villas and fincas' },
          { href: `${r('contact')}#demo`, label: 'Get a demo with your property' },
        ],
    faq: [
      ...(isVilla ? [{ q: 'Which camera moves work for a villa?', a: 'The ones the photo allows without forcing it: lateral glides at water level, push-ins towards the façade or the living room, and rising shots that open up the frame. Here, the glide across the infinity pool and the final rise are the two shots closest to a drone.' }] : []),
      { q: 'Is everything in the film in the photos?', a: 'Yes. Every shot comes from a single photo: the AI computes its depth and the camera moves inside it, so no room, furniture or view appears that isn’t in the photo. Between shots there is a dissolve, not an invented transition. Even so, the film is published labelled as AI-made.' },
    ],
    cta: { eyebrow: 'Your property', title: 'Is the next demo yours?', text: 'Send us the photos of a villa or a finca and within 72 hours you’ll have a sample film, free and with no commitment.' },
    more: 'More demos',
  },
}[lang];

const posterImg = await getImage({ src: demo.poster, width: 1280, format: 'webp', quality: 74 });
const ogImg = await getImage({ src: demo.poster, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
// misma miniatura (mismos parámetros → mismo archivo) que en sitemap-video.xml
const thumb = await getImage({ src: demo.poster, width: 1280, format: 'jpg', quality: 78 });
const crumbs = [{ name: c.crumb, path: r('demos') }, { name: demo.title[lang], path }];
const schema = [videoNode(demo, lang, path, thumb.src), faqNode(path, c.faq)];
---
<Base lang={lang} title={seo.title} description={seo.description} path={path} alt={altPath} crumbs={crumbs} schema={schema} ogImage={ogImg.src} ogImageAlt={demo.title[lang]} preload={[{ href: posterImg.src }]}>
  <section class="watch">
    <div class="wrap wrap--wide watch__inner">
      <Breadcrumbs lang={lang} crumbs={crumbs} />
      <div class="watch__title">
        <p class="eyebrow enter" style="--d: 0.05s">Demo {demo.num} · {demo.summary[lang]}</p>
        <h1 class="h-1 enter" style="--d: 0.1s"><Title text={seo.h1} /></h1>
      </div>
      <figure class="watch__player" style={`view-transition-name: ${demo.vt}`}>
        <div class="media-frame ratio-16x9">
          <video id="demo-video" controls playsinline preload="metadata" poster={posterImg.src} width={demo.video.width} height={demo.video.height}>
            <source src={demo.video.webm} type="video/webm" />
            <source src={demo.video.mp4} type="video/mp4" />
          </video>
        </div>
        <figcaption class="watch__caption">
          <span class="watch__ai small-caps"><span class="watch__ai-dot" aria-hidden="true"></span>{c.label}</span>
          <span class="muted">{demo.description[lang]}</span>
        </figcaption>
      </figure>
      <dl class="facts watch__facts">
        <div class="fact"><dt class="fact__label">{c.facts.photos}</dt><dd class="fact__value num">{demo.photos.length}</dd></div>
        <div class="fact"><dt class="fact__label">{c.facts.duration}</dt><dd class="fact__value num">{demo.video.durationSec}<small>s</small></dd></div>
        <div class="fact"><dt class="fact__label">{c.facts.format}</dt><dd class="fact__value num">16:9</dd></div>
        <div class="fact"><dt class="fact__label">{c.facts.style}</dt><dd class="fact__value fact__value--text">{demo.style[lang]}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--light" aria-labelledby="source-title">
    <div class="wrap wrap--wide">
      <header class="section-head">
        <div class="section-head__main"><p class="eyebrow">{c.source.eyebrow}</p><h2 id="source-title" class="display title" data-reveal="lines">{c.source.title}</h2></div>
        <p class="lede" data-reveal="fade">{c.source.lede}</p>
      </header>
      <ol class:list={['source-grid', `source-grid--${demo.photos.length}`]} data-reveal="stagger">
        {demo.photos.map((p, i) => (
          <li>
            <figure>
              <div class="media-frame ratio-16x9"><Image src={p.src} alt={p.alt[lang]} widths={[480, 800, 1200]} sizes="(min-width: 900px) 33vw, 100vw" quality={72} loading="lazy" /></div>
              <figcaption class="caption"><span class="gold num">{String(i + 1).padStart(2, '0')}</span> · {p.alt[lang]}</figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--raised" aria-labelledby="shots-title">
    <div class="wrap wrap--wide shots">
      <div>
        <p class="eyebrow">{c.shots.eyebrow}</p>
        <h2 id="shots-title" class="display title" data-reveal="lines">{c.shots.title}</h2>
      </div>
      <ol class="shots__list" data-reveal="stagger">
        {demo.shots[lang].map((s, i) => (
          <li><span class="shots__num num">{String(i + 1).padStart(2, '0')}</span><p>{s}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--light" aria-labelledby="retouch-title">
    <div class="wrap wrap--wide">
      <header class="section-head section-head--stack">
        <div class="section-head__main"><p class="eyebrow">{c.retouch.eyebrow}</p><h2 id="retouch-title" class="display title" data-reveal="lines"><Title text={c.retouch.title} /></h2></div>
      </header>
      <div class="grid-2" data-reveal="stagger">
        <div class="card"><h3 class="card__title">{c.retouch.done.t}</h3><ul class="check-list">{c.retouch.done.items.map((i) => <li>{i}</li>)}</ul></div>
        <div class="card"><h3 class="card__title">{c.retouch.kept.t}</h3><ul class="check-list">{c.retouch.kept.items.map((i) => <li>{i}</li>)}</ul></div>
      </div>
      <div class="demo-faq"><FaqList items={c.faq} openFirst /></div>
      <nav class="related-links" aria-label={c.more}>
        {c.links.map((l) => <a class="link-quiet" href={l.href} data-open-demo-modal={l.href.endsWith('#demo') ? '' : undefined}>{l.label}<Icon name="arrow" /></a>)}
      </nav>
    </div>
  </section>

  <CtaBand lang={lang} eyebrow={c.cta.eyebrow} title={c.cta.title} text={c.cta.text} secondary={{ href: r('demos'), label: c.more }} />
</Base>

<style>
  .watch { padding-top: calc(var(--header-h) + clamp(40px, 6vw, 80px)); padding-bottom: clamp(48px, 7vw, 88px); background: #ffffff; }
  .watch__inner { display: grid; gap: 28px; }
  .watch__title { display: grid; gap: 22px; justify-items: start; margin: 0; font-weight: inherit; max-width: 1100px; }
  .watch__player { margin-top: 8px; }
  .watch__player :global(.media-frame) { border-radius: var(--radius-lg); }
  .watch__player video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #000; }
  .watch__caption { display: grid; gap: 10px; margin-top: 16px; max-width: 78ch; }
  .watch__ai { display: inline-flex; align-items: center; gap: 10px; color: var(--ink-soft); }
  .watch__ai-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ink); }
  .watch__facts { margin-top: 16px; }
  .watch__facts :global(.fact) { background: var(--bg); }
  /* «Contemporánea» no cabe entera en media columna de móvil: se guiona (y, si no hay diccionario, se parte) */
  .fact__value--text { font-size: clamp(1.25rem, 0.95rem + 1.2vw, 2.125rem); text-transform: uppercase; letter-spacing: 0; line-height: 1.1; hyphens: auto; overflow-wrap: break-word; }
  .source-grid { display: grid; gap: 12px; }
  @media (width >= 700px) { .source-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width >= 1100px) { .source-grid--5 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .source-grid :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .shots { display: grid; gap: 40px; }
  @media (width >= 900px) { .shots { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 64px; } }
  .shots__list { display: grid; gap: 8px; }
  .shots__list li { display: grid; grid-template-columns: 44px 1fr; gap: 12px; padding: 20px 22px; border-radius: var(--radius-sm); background: var(--bg-raised); color: var(--ink-soft); }
  .shots__num { font-family: var(--font-label); color: var(--muted); font-size: 0.9375rem; padding-top: 2px; }
  .demo-faq { margin-top: clamp(48px, 6vw, 80px); max-width: 860px; margin-inline: auto; }
  .related-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 28px; margin-top: 40px; }
</style>
