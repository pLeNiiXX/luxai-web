---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { routes, otherLang, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { itemListNode } from '../lib/seo';
import { getGuides, guidePath } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang);
const r = (k: keyof typeof routes) => routes[k][lang];
const path = r('guides');
const guides = await getGuides(lang);
const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const c = {
  es: {
    title: 'Guías de vídeo inmobiliario con IA | LUXAI',
    description: 'Para inmobiliarias y gestores de villas: dron o IA, cómo hacer las fotos, formatos para idealista y redes, y cómo usar IA en anuncios sin engañar.',
    h1: 'Guías de vídeo inmobiliario',
    eyebrow: 'Recursos',
    lede: 'Lo que conviene saber antes de encargar o publicar un vídeo de una propiedad: normativa, formatos, fotos y transparencia. Con fuentes y fecha de actualización.',
    links: [
      { key: 'how', label: 'Cómo trabajamos' },
      { key: 'pricing', label: 'Precios y comparativa' },
      { key: 'demos', label: 'Ejemplos reales' },
    ],
  },
  en: {
    title: 'Real Estate Video Guides | LUXAI',
    description: 'For agencies and villa managers: drone or AI, which photos to take, video formats for portals and social, and how to use AI in listings honestly.',
    h1: 'Real estate video guides',
    eyebrow: 'Resources',
    lede: 'What’s worth knowing before you commission or publish a property film: regulation, formats, photos and transparency. With sources and update dates.',
    links: [
      { key: 'how', label: 'How we work' },
      { key: 'pricing', label: 'Pricing and comparison' },
      { key: 'demos', label: 'Real examples' },
    ],
  },
}[lang];

const crumbs = [{ name: u.links.guides, path }];
const schema = [itemListNode(path, guides.map((g) => ({ name: g.data.title, path: guidePath(g) })))];
---
<Base lang={lang} title={c.title} description={c.description} path={path} alt={routes.guides[otherLang(lang)]} crumbs={crumbs} pageType="CollectionPage" schema={schema}>
  <PageHero lang={lang} crumbs={crumbs} eyebrow={c.eyebrow} title={c.h1} lede={c.lede} />

  <section class="section section--light section--tight">
    <div class="wrap wrap--wide">
      <ol class="guides">
        {guides.map((g, i) => (
          <li data-reveal="fade">
            <a class="guide-row" href={guidePath(g)}>
              <span class="guide-row__n num">{String(i + 1).padStart(2, '0')}</span>
              <span class="guide-row__main">
                <span class="guide-row__title">{g.data.title}</span>
                <span class="guide-row__excerpt">{g.data.excerpt}</span>
              </span>
              <span class="guide-row__meta small-caps muted">{g.data.readingMinutes} {u.guide.minutes}<br />{u.guide.updated} {fmt.format(g.data.updated)}</span>
              <span class="guide-row__arrow" aria-hidden="true"><Icon name="arrow" /></span>
            </a>
          </li>
        ))}
      </ol>
      <nav class="related-links" aria-label={u.links.guides}>
        {c.links.map((l) => <a class="link-quiet" href={r(l.key as 'how' | 'pricing' | 'demos')}>{l.label}<Icon name="arrow" /></a>)}
      </nav>
    </div>
  </section>

  <CtaBand lang={lang} eyebrow={u.cta.demo} title={lang === 'es' ? 'La mejor guía es ver vuestra propiedad en vídeo' : 'The best guide is seeing your own property on film'} text={lang === 'es' ? 'Enviadnos las fotos de un espacio y en 72 horas tenéis una demo, sin coste.' : 'Send us the photos of one property and within 72 hours you’ll have a demo, free of charge.'} />
</Base>

<style>
  .guides { display: grid; gap: 12px; }
  .guide-row {
    display: grid; grid-template-columns: 40px 1fr; gap: 12px 16px; align-items: start;
    padding: clamp(22px, 2.6vw, 32px); border-radius: var(--radius); background: var(--bg-raised);
    text-decoration: none; color: var(--ink); border: 1px solid transparent; transition: border-color 0.25s ease;
  }
  @media (width >= 900px) { .guide-row { grid-template-columns: 56px minmax(0, 1fr) 190px 44px; align-items: center; } }
  .guide-row__n { font-family: var(--font-label); color: var(--muted); font-size: 0.9375rem; }
  .guide-row__main { display: grid; gap: 10px; }
  .guide-row__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.75rem); letter-spacing: -0.04em; line-height: 1.15; text-wrap: balance; }
  .guide-row__excerpt { font-family: var(--font-label); text-transform: uppercase; color: var(--muted); max-width: 70ch; line-height: 1.45; }
  .guide-row__meta { grid-column: 2; line-height: 1.6; }
  @media (width >= 900px) { .guide-row__meta { grid-column: auto; text-align: right; } }
  .guide-row__arrow { display: none; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--dark); color: #ffffff; }
  .guide-row__arrow :global(svg) { width: 14px; height: 14px; transition: transform 0.25s var(--ease-out); }
  @media (width >= 900px) { .guide-row__arrow { display: grid; } }
  @media (hover: hover) and (pointer: fine) {
    .guide-row:hover { border-color: var(--line-strong); }
    .guide-row:hover .guide-row__arrow :global(svg) { transform: translateX(3px); }
  }
</style>
