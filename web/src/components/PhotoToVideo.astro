---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Title from './Title.astro';
import VideoToggle from './VideoToggle.astro';
import PreviewSources from './PreviewSources.astro';
import type { Demo } from '../data/demos';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  demo: Demo;
  eyebrow: string;
  title: string;
  lede: string;
  inLabel: string;
  outLabel: string;
  outDetail: string;
  link: { href: string; label: string };
}
const { lang, demo, eyebrow, title, lede, inLabel, outLabel, outDetail, link } = Astro.props;
const n = demo.photos.length;
---
<section class="p2v section" data-p2v aria-labelledby="p2v-title">
  <div class="p2v__stage" data-p2v-stage>
    <div class="wrap wrap--wide p2v__head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="p2v-title" class="display title" data-reveal="lines"><Title text={title} /></h2>
      <p class="lede">{lede}</p>
    </div>

    <div class="wrap wrap--wide">
      <div class="p2v__canvas" data-p2v-canvas>
        <div class="p2v__in">
          <p class="small-caps p2v__label" data-p2v-label-in><span class="gold num">{String(n).padStart(2, '0')}</span> {inLabel}</p>
          <ol class="p2v__photos" data-p2v-photos>
            {demo.photos.map((p, i) => (
              <li class="p2v__photo" data-p2v-photo>
                <Image src={p.src} alt={p.alt[lang]} widths={[360, 640]} sizes="(min-width: 900px) 22vw, 45vw" quality={70} loading="lazy" fetchpriority="low" />
                <span class="p2v__tag chip num">{String(i + 1).padStart(2, '0')}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="p2v__arrow" aria-hidden="true" data-p2v-arrow><Icon name="arrow" /></div>

        <figure class="p2v__film" data-p2v-film>
          <p class="small-caps p2v__label" data-p2v-label-out><span class="gold">LUXAI</span> {outLabel}</p>
          <div class="p2v__screen media-frame ratio-16x9">
            <Image src={demo.poster} alt="" widths={[640, 1280]} sizes="(min-width: 900px) 60vw, 100vw" quality={70} loading="lazy" fetchpriority="low" class="p2v__poster" />
            <video id="p2v-vid" muted loop playsinline preload="none" data-inview aria-label={demo.description[lang]}>
              <PreviewSources preview={demo.video.preview} />
            </video>
            <VideoToggle lang={lang} target="p2v-vid" />
          </div>
          <figcaption class="p2v__caption">
            <span>{outDetail}</span>
            <a class="link-quiet" href={link.href}>{link.label}<Icon name="arrow" /></a>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .p2v { overflow: clip; }
  .p2v__head { display: grid; gap: 22px; justify-items: center; text-align: center; margin-bottom: clamp(40px, 6vw, 72px); }
  .p2v__head .title { max-width: 18ch; }
  .p2v__canvas { position: relative; display: grid; gap: 24px; align-items: center; }
  @media (width >= 900px) { .p2v__canvas { grid-template-columns: minmax(0, 5fr) auto minmax(0, 6.4fr); gap: clamp(20px, 2.6vw, 40px); } }
  .p2v__label { margin-bottom: 12px; color: var(--muted); }
  .p2v__photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .p2v__photo { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 14px; background: var(--bg-sunk); }
  .p2v__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .p2v__tag { position: absolute; left: 8px; bottom: 8px; }
  .p2v__arrow { display: grid; place-items: center; width: 48px; height: 48px; margin-inline: auto; border-radius: 50%; background: var(--dark); color: #ffffff; }
  .p2v__arrow :global(svg) { width: 15px; height: 15px; }
  @media (width < 900px) { .p2v__arrow :global(svg) { transform: rotate(90deg); } }
  .p2v__screen { position: relative; border-radius: var(--radius-lg); }
  .p2v__screen video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .p2v__poster { width: 100%; height: 100%; object-fit: cover; }
  .p2v__caption { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 24px; margin-top: 12px; color: var(--muted); font-family: var(--font-label); text-transform: uppercase; font-size: 0.875rem; }
  .p2v__caption :global(.link-quiet) { font-family: var(--font-display); text-transform: none; font-size: 0.9375rem; }

  /* modo animado: el escenario se ancla y las fotos convergen en el vídeo */
  :global(.p2v[data-live]) .p2v__stage { min-height: 100svh; display: grid; align-content: center; padding-block: calc(var(--header-h) + 16px) 24px; }
  :global(.p2v[data-live]) { padding-block: 0; }
  :global(.p2v[data-live]) .p2v__head { margin-bottom: clamp(24px, 3.4vw, 44px); }
</style>

<script>
  import { loadMotion, canAutoplay } from '../scripts/core';

  loadMotion().then((m) => {
    const section = document.querySelector<HTMLElement>('[data-p2v]');
    if (!m || !section) return;
    const { gsap, ScrollTrigger } = m;
    const mm = gsap.matchMedia();

    mm.add('(min-width: 900px) and (min-height: 640px)', () => {
      section.setAttribute('data-live', '');
      const stage = section.querySelector<HTMLElement>('[data-p2v-stage]')!;
      const photos = Array.from(section.querySelectorAll<HTMLElement>('[data-p2v-photo]'));
      const film = section.querySelector<HTMLElement>('[data-p2v-film]')!;
      const screen = film.querySelector<HTMLElement>('.p2v__screen')!;
      const arrow = section.querySelector<HTMLElement>('[data-p2v-arrow]')!;
      const video = film.querySelector('video');
      // en modo anclado, el vídeo lo arranca la secuencia (no el observador genérico)
      video?.removeAttribute('data-inview');

      // vector desde el centro de cada foto al centro de la pantalla del vídeo.
      // Se mide con offsets de layout (no afectados por transforms) para que sea estable en cada refresh.
      const canvas = section.querySelector<HTMLElement>('[data-p2v-canvas]')!;
      const pos = (el: HTMLElement) => {
        let x = 0, y = 0, n: HTMLElement | null = el;
        while (n && n !== canvas) {
          x += n.offsetLeft;
          y += n.offsetTop;
          n = n.offsetParent as HTMLElement | null;
        }
        return { x: x + el.offsetWidth / 2, y: y + el.offsetHeight / 2 };
      };
      const delta = (el: HTMLElement) => {
        const a = pos(el);
        const b = pos(screen);
        return { x: b.x - a.x, y: b.y - a.y };
      };

      // entrada de las fotos al llegar a la sección (no ligada al scroll)
      gsap.from(photos, { opacity: 0, y: 36, duration: 0.9, stagger: 0.08, ease: 'power3.out', scrollTrigger: { trigger: canvas, start: 'top 88%', once: true } });

      const tl = gsap.timeline({
        defaults: { ease: 'power2.inOut' },
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: '+=150%',
          pin: stage,
          scrub: 0.8,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (!video) return;
            if (self.progress > 0.45 && video.paused && !video.hasAttribute('data-user-paused') && canAutoplay()) {
              video.preload = 'auto';
              video.play().catch(() => {});
            }
          },
        },
      });

      tl.fromTo(screen, { clipPath: 'inset(46% 46% 46% 46% round 28px)' }, { clipPath: 'inset(0% 0% 0% 0% round 28px)', duration: 1, ease: 'expo.inOut' }, 0.85)
        .from(film.querySelectorAll('.p2v__label, .p2v__caption'), { opacity: 0, y: 14, duration: 0.4, stagger: 0.1 }, 1.45)
        .to(photos, {
          x: (_i, el) => delta(el as HTMLElement).x,
          y: (_i, el) => delta(el as HTMLElement).y,
          scale: 0.4,
          duration: 1,
          stagger: 0.06,
        }, 0.1)
        .to(arrow, { opacity: 0, scale: 0.6, duration: 0.3 }, 0.1)
        .to(photos, { opacity: 0, duration: 0.3, stagger: 0.04 }, 0.9)
        .to(section.querySelector('[data-p2v-label-in]'), { opacity: 0, duration: 0.3 }, 0.3)
        .to({}, { duration: 0.35 });

      return () => {
        section.removeAttribute('data-live');
        video?.setAttribute('data-inview', '');
      };
    });

    ScrollTrigger.refresh();
  });
</script>
