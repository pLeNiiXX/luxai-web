---
interface Props { items: { q: string; a: string }[]; openFirst?: boolean }
const { items, openFirst = false } = Astro.props;
---
<div class="faq" data-reveal="fade">
  {items.map((it, i) => (
    <details open={openFirst && i === 0}>
      <summary><span>{it.q}</span><span class="faq__icon" aria-hidden="true"></span></summary>
      <div class="faq__answer" set:html={it.a} />
    </details>
  ))}
</div>
