---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import VideoToggle from './VideoToggle.astro';
import PreviewSources from './PreviewSources.astro';
import { DEMOS } from '../data/demos';
import { collectionBase, routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang; cta: { eyebrow: string; title: string; text: string } }
const { lang, cta } = Astro.props;
const u = t(lang);
---
<ul class="acc" data-acc>
  {DEMOS.map((d, i) => (
    <li class="acc__item" data-acc-item data-active={i === 0 ? '' : undefined}>
      <a class="acc__link" href={`${collectionBase.demos[lang]}${d.slug[lang]}/`}>
        <div class="acc__media" style={`view-transition-name: ${d.vt}`}>
          <Image src={d.poster} alt={d.photos[0].alt[lang]} widths={[640, 960, 1440]} sizes="(min-width: 900px) 55vw, 100vw" quality={70} loading="lazy" />
          <video id={`acc-vid-${d.key}`} muted loop playsinline preload="none" data-acc-video aria-hidden="true">
            <PreviewSources preview={d.video.preview} />
          </video>
        </div>
        <div class="acc__body">
          <span class="small-caps acc__num"><span class="gold">Demo {d.num}</span> · {d.summary[lang]}</span>
          <h3 class="acc__title">{d.title[lang]}</h3>
          <p class="acc__tagline">{d.tagline[lang]}</p>
          <span class="link-quiet acc__more">{u.cta.seeDemo}<Icon name="arrow" /></span>
        </div>
      </a>
      <VideoToggle lang={lang} target={`acc-vid-${d.key}`} />
    </li>
  ))}
  <li class="acc__item acc__item--cta" data-acc-item>
    <a class="acc__link" href={`${routes.contact[lang]}#demo`} data-open-demo-modal>
      <div class="acc__body acc__body--cta">
        <span class="small-caps gold">{cta.eyebrow}</span>
        <h3 class="acc__title">{cta.title}</h3>
        <p class="acc__tagline">{cta.text}</p>
        <span class="btn btn--gold acc__btn">{u.cta.demo}<Icon name="arrow" /></span>
      </div>
    </a>
  </li>
</ul>

<style>
  .acc { display: grid; gap: 12px; }
  .acc__item { position: relative; overflow: hidden; background: var(--bg-raised); border: 1px solid var(--line); }
  .acc__link { position: relative; display: grid; height: 100%; text-decoration: none; color: var(--ink); }
  .acc__link:focus-visible { outline-offset: -6px; }
  .acc__media { position: relative; aspect-ratio: 16 / 11; overflow: hidden; }
  .acc__media :global(img), .acc__media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .acc__media video { opacity: 0; transition: opacity 0.6s var(--ease-out); }
  .acc__media video[data-playing] { opacity: 1; }
  .acc__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, #0b0b0c00 40%, #0b0b0cd9 100%); }
  .acc__body { display: grid; gap: 10px; padding: 22px 22px 26px; }
  .acc__num { color: var(--muted); }
  .acc__title { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem); letter-spacing: 0.16em; text-transform: uppercase; line-height: 1.25; }
  .acc__tagline { color: var(--muted); max-width: 40ch; }
  .acc__item--cta { background: linear-gradient(160deg, #1a1714 0%, var(--bg-raised) 60%); border-color: var(--gold-soft); }
  .acc__body--cta { align-content: center; min-height: 280px; padding: 32px 26px; }
  .acc__btn { justify-self: start; margin-top: 10px; }

  @media (width >= 900px) {
    .acc { display: flex; height: clamp(460px, 62vh, 660px); gap: 10px; }
    .acc__item { flex: 1 1 0; min-width: 0; transition: flex-grow 0.8s var(--ease-drawer), border-color 0.3s ease; }
    .acc__item[data-active] { flex-grow: 2.4; border-color: var(--line-strong); }
    .acc__item--cta { flex-grow: 0.8; }
    .acc__item--cta[data-active] { flex-grow: 1.3; }
    .acc__media { position: absolute; inset: 0; aspect-ratio: auto; }
    .acc__media :global(img) { transform: scale(1.04); transition: transform 1.2s var(--ease-out); }
    .acc__item[data-active] .acc__media :global(img) { transform: none; }
    .acc__body { position: absolute; inset: auto 0 0 0; padding: 28px; }
    .acc__body--cta { position: relative; inset: auto; height: 100%; }
    .acc__tagline, .acc__more { opacity: 0; transform: translateY(8px); transition: opacity 0.4s ease, transform 0.5s var(--ease-out); }
    .acc__item[data-active] .acc__tagline, .acc__item[data-active] .acc__more { opacity: 1; transform: none; transition-delay: 0.25s; }
    .acc__title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .acc__item[data-active] .acc__title { white-space: normal; }
    .acc__item--cta .acc__tagline { opacity: 1; transform: none; }
    .acc__item:not([data-active]) :global(.vid-toggle) { visibility: hidden; }
  }
</style>

<script>
  import { canAutoplay } from '../scripts/core';

  document.querySelectorAll<HTMLElement>('[data-acc]').forEach((acc) => {
    const items = Array.from(acc.querySelectorAll<HTMLElement>('[data-acc-item]'));
    const desktop = window.matchMedia('(min-width: 900px)');

    const playIn = (item: HTMLElement | undefined) => {
      acc.querySelectorAll<HTMLVideoElement>('[data-acc-video]').forEach((v) => {
        const inItem = item?.contains(v);
        if (inItem && !v.hasAttribute('data-user-paused') && canAutoplay()) {
          v.preload = 'auto';
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
    };
    const activate = (item: HTMLElement) => {
      if (!desktop.matches) return;
      items.forEach((i) => i.toggleAttribute('data-active', i === item));
      playIn(item);
    };
    items.forEach((item) => {
      item.addEventListener('pointerenter', () => activate(item));
      item.addEventListener('focusin', () => activate(item));
    });

    // en escritorio, el panel activo reproduce cuando el bloque entra en pantalla
    new IntersectionObserver(([e]) => {
      if (!desktop.matches) return;
      if (e.isIntersecting) playIn(items.find((i) => i.hasAttribute('data-active')));
      else playIn(undefined);
    }, { threshold: 0.35 }).observe(acc);

    // en móvil, cada tarjeta reproduce al verse
    const io = new IntersectionObserver((entries) => {
      if (desktop.matches) return;
      for (const en of entries) {
        const v = en.target.querySelector<HTMLVideoElement>('[data-acc-video]');
        if (!v) continue;
        if (en.isIntersecting && !v.hasAttribute('data-user-paused') && canAutoplay()) {
          v.preload = 'auto';
          v.play().catch(() => {});
        } else v.pause();
      }
    }, { threshold: 0.6 });
    items.forEach((i) => io.observe(i));
  });
</script>
