---
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang; target: string }
const { lang, target } = Astro.props;
const u = t(lang).video;
---
<button class="vid-toggle" type="button" data-video-toggle aria-controls={target} data-label-pause={u.pause} data-label-play={u.play}>
  <span class="vid-toggle__icon" aria-hidden="true"></span>
  <span class="visually-hidden" data-label>{u.pause}</span>
</button>

<style>
  :global(html:not(.js)) .vid-toggle { display: none; }
</style>
