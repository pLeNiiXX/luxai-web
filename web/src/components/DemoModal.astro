---
import DemoForm from './DemoForm.astro';
import Icon from './Icon.astro';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang).modal;
---
<dialog id="demo-modal" class="demo-modal" aria-labelledby="demo-modal-title" data-lenis-prevent>
  <div class="demo-modal__panel">
    <button type="button" class="demo-modal__close" data-modal-close aria-label={u.close}><Icon name="close" /></button>
    <p class="eyebrow">{u.eyebrow}</p>
    <h2 id="demo-modal-title" class="display demo-modal__title">{u.title}</h2>
    <p class="demo-modal__text">{u.text}</p>
    <DemoForm lang={lang} id="modal" />
  </div>
</dialog>

<style>
  .demo-modal {
    width: min(560px, calc(100vw - 24px));
    max-height: calc(100dvh - 24px);
    margin: auto; padding: 0; border: 0; border-radius: var(--radius-lg);
    background: #ffffff; color: var(--ink); box-shadow: 0 30px 80px #0000002e;
    overflow: auto; overscroll-behavior: contain;
    opacity: 0; transform: translateY(16px) scale(0.98);
    transition: opacity 0.24s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .demo-modal[data-open] { opacity: 1; transform: none; }
  .demo-modal::backdrop { background: #26262659; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); opacity: 0; transition: opacity 0.24s ease; }
  .demo-modal[data-open]::backdrop { opacity: 1; }
  .demo-modal__panel { position: relative; display: grid; gap: 16px; padding: clamp(28px, 5vw, 44px); }
  .demo-modal__title { font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem); letter-spacing: -0.05em; padding-right: 36px; }
  .demo-modal__text { font-family: var(--font-label); text-transform: uppercase; color: var(--muted); margin-bottom: 8px; line-height: 1.45; }
  .demo-modal__close {
    position: absolute; top: 14px; right: 14px; display: grid; place-items: center;
    width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--bg); color: var(--ink); cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .demo-modal__close :global(svg) { width: 14px; height: 14px; }
  @media (hover: hover) and (pointer: fine) { .demo-modal__close:hover { background: var(--bg-sunk); } }
</style>
